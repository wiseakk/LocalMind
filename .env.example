# Keep LOCALMIND_HOST=127.0.0.1 for the first launch.
LOCALMIND_HOST=127.0.0.1
LOCALMIND_PORT=8765
# Set a long random key BEFORE binding to 0.0.0.0 for LAN testing
LOCALMIND_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# DEMO mode NEVER sends commands to real home devices.
DEMO_MODE=true
# For real HA: DEMO_MODE=false and set both variables below.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Only needed if installing requirements-voice.txt
WHISPER_MODEL=base
