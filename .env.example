# LocalMind 1.0 always listens on 127.0.0.1. LAN access is disabled.
LOCALMIND_PORT=8765
# Optional defence-in-depth key for other local processes.
LOCALMIND_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
# DEMO mode NEVER sends commands to real home devices.
DEMO_MODE=true
# For real HA: DEMO_MODE=false and set both variables below.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Voice profiles are selected in Russian UI settings. Download models explicitly;
# see docs/VOICE.md. Inference never downloads assets.
# Model Manager disk capacity remains unknown unless the operator verifies the
# actual Ollama daemon store. Never substitute the project disk. Optional:
# OLLAMA_MODELS=C:/confirmed/ollama/models
# LOCALMIND_OLLAMA_STORAGE_VERIFIED=true
