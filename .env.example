# LocalMind 0.1 always listens on 127.0.0.1. LAN access is disabled.
LOCALMIND_PORT=8765
# Optional defence-in-depth key for other local processes.
LOCALMIND_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# DEMO mode NEVER sends commands to real home devices.
DEMO_MODE=true
# For real HA: DEMO_MODE=false and set both variables below.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Only needed if installing requirements-voice.txt
WHISPER_MODEL=base
